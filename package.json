    "@angular/platform-browser": "19.1.8",
    "@angular/router": "19.1.8",
    "d3": "7.9.0",
    "rxjs": "7.8.1",
    "tiktoken": "1.0.20",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.1.8",
    "@angular/cli": "19.1.8",
    "@angular/compiler-cli": "19.1.8",
    "@types/d3": "7.4.3",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  },
